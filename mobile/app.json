{
  "expo": {
    "name": "Solv",
    "slug": "solv",
    "scheme": "solv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jvoliveira.solv"
    },
    "android": {
      "package": "com.jvoliveira.solv",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-status-bar",
      "expo-font",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#2d6fff",
          "defaultChannel": "chat"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0871377b-c5b5-41b9-8473-d3aa4796a52e"
      }
    },
    "owner": "bianchihaki"
  }
}
