generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Convenções de tipos deste schema:
// - Conjuntos de valores fixos que podem evoluir (perfil, categoria, status
//   do chamado, denúncia...) são VARCHAR(n) com CHECK no banco
//   (chk_<tabela>_<coluna>): evoluir um conjunto é só ajustar o CHECK, sem
//   ALTER TYPE. O Prisma não modela CHECK, então eles vivem nas migrations.
// - ENUM nativo só em 3 conjuntos pequenos e estáveis: Prioridade (a ordem do
//   enum ordena a fila), StatusMensagem e IniciadoPor.
// - Datas são TIMESTAMPTZ (o banco sabe o fuso; o Prisma sempre usa UTC).
// - Texto curto tem limite (VARCHAR); texto livre (mensagens, descrições) é TEXT.

// Ordem importa: a fila ordena por prioridade usando a ordem declarada aqui.
enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum StatusMensagem {
  ENVIADA
  ENTREGUE
  LIDA
}

enum IniciadoPor {
  USUARIO
  TECNICO
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  senha     String   @db.VarChar(60) // hash bcrypt tem sempre 60 caracteres
  setor     String?  @db.VarChar(80)
  avatar    String?  @db.Text
  pushToken String?  @db.VarChar(255)
  perfil    String   @default("USUARIO") @db.VarChar(10) // USUARIO | TECNICO | ADMIN
  criadoEm  DateTime @default(now()) @db.Timestamptz(3)

  // Um técnico pertence a no máximo um time por vez. `adminDoTime` só faz
  // sentido junto com `timeId` — marca quem administra aquele time
  // específico, sem precisar ser ADMIN global do sistema.
  timeId      String?
  time        Time?   @relation(fields: [timeId], references: [id])
  adminDoTime Boolean @default(false)

  // Restrição aplicada por um ADMIN: conta suspensa não loga nem usa a API.
  suspenso        Boolean @default(false)
  motivoSuspensao String? @db.VarChar(200)

  // Recuperação de senha: só guarda o hash do código de 6 dígitos, com
  // validade curta (RN19) e limite de tentativas contra força bruta.
  resetCodigoHash String?   @db.VarChar(60)
  resetExpiraEm   DateTime? @db.Timestamptz(3)
  resetTentativas Int       @default(0)

  denunciasFeitas     Denuncia[] @relation("Denunciante")
  denunciasRecebidas  Denuncia[] @relation("Denunciado")

  chamadosAbertos   Chamado[]    @relation("Solicitante")
  chamadosAtendidos Chamado[]    @relation("Tecnico")
  mensagens         Mensagem[]
  mensagensTime     MensagemTime[]
  chatsComoSolicitante ChatSessao[] @relation("ChatSolicitante")
  chatsComoTecnico  ChatSessao[] @relation("ChatTecnico")
  avaliacoes        Avaliacao[]
}

// Agrupa técnicos por especialidade. As categorias definem quais chamados
// "pertencem" ao time — usado pra destacar a fila do painel.
model Time {
  id         String   @id @default(uuid())
  nome       String   @db.VarChar(80)
  criadoEm   DateTime @default(now()) @db.Timestamptz(3)

  categorias TimeCategoria[]
  membros    Usuario[]
  mensagens  MensagemTime[]
}

// Categorias que o time atende (1ª forma normal: uma linha por categoria,
// em vez de um array dentro do Time). O valor é validado por CHECK.
model TimeCategoria {
  timeId    String
  categoria String @db.VarChar(12) // HARDWARE | SOFTWARE | REDE | ACESSO | IMPRESSORA | OUTRO

  time Time @relation(fields: [timeId], references: [id], onDelete: Cascade)

  @@id([timeId, categoria])
}

// Chat interno do time (técnicos + admin do time conversando entre si).
// Diferente de Mensagem, que é do chat 1:1 com o solicitante: aqui o
// próprio time já é o canal, não precisa de sessão que nasce/encerra.
model MensagemTime {
  id       String   @id @default(uuid())
  texto    String
  criadoEm DateTime @default(now()) @db.Timestamptz(3)

  autorId String
  autor   Usuario @relation(fields: [autorId], references: [id])

  timeId String
  time   Time   @relation(fields: [timeId], references: [id])
}

model Chamado {
  id           String   @id @default(uuid())
  titulo       String   @db.VarChar(150)
  descricao    String
  categoria    String   @db.VarChar(12) // HARDWARE | SOFTWARE | REDE | ACESSO | IMPRESSORA | OUTRO
  prioridade   Prioridade @default(MEDIA)
  status       String   @default("ABERTO") @db.VarChar(16) // ABERTO | EM_ATENDIMENTO | AGUARDANDO | RESOLVIDO | FECHADO
  localizacao  String?  @db.VarChar(150)
  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  solicitanteId String
  solicitante   Usuario  @relation("Solicitante", fields: [solicitanteId], references: [id])

  tecnicoId String?
  tecnico   Usuario? @relation("Tecnico", fields: [tecnicoId], references: [id])

  chat        ChatSessao?
  avaliacao   Avaliacao?
  denuncias   Denuncia[]
}

// Usuário denuncia o técnico que atendeu um chamado seu. Uma denúncia por
// chamado por denunciante (evita spam); o ADMIN julga e responde.
model Denuncia {
  id            String    @id @default(uuid())
  motivo        String    @db.VarChar(20) // COMPORTAMENTO | RESPONSABILIDADE | OUTRO
  descricao     String
  status        String    @default("PENDENTE") @db.VarChar(14) // PENDENTE | PROCEDENTE | IMPROCEDENTE
  criadoEm      DateTime  @default(now()) @db.Timestamptz(3)
  resolvidoEm   DateTime? @db.Timestamptz(3)
  respostaAdmin String?

  chamadoId String
  chamado   Chamado @relation(fields: [chamadoId], references: [id])

  denuncianteId String
  denunciante   Usuario @relation("Denunciante", fields: [denuncianteId], references: [id])

  denunciadoId String
  denunciado   Usuario @relation("Denunciado", fields: [denunciadoId], references: [id])

  @@unique([chamadoId, denuncianteId])
}

model ChatSessao {
  id        String   @id @default(uuid())
  status    String   @default("PENDENTE") @db.VarChar(10) // PENDENTE | ATIVA | ENCERRADA
  criadoEm  DateTime @default(now()) @db.Timestamptz(3)

  iniciadoPor            IniciadoPor @default(USUARIO)
  encerradoPorResolucao  Boolean @default(false)

  chamadoId String   @unique
  chamado   Chamado  @relation(fields: [chamadoId], references: [id])

  solicitanteId String
  solicitante   Usuario  @relation("ChatSolicitante", fields: [solicitanteId], references: [id])

  tecnicoId String
  tecnico   Usuario  @relation("ChatTecnico", fields: [tecnicoId], references: [id])

  mensagens Mensagem[]
}

model Mensagem {
  id        String   @id @default(uuid())
  texto     String
  criadoEm  DateTime @default(now()) @db.Timestamptz(3)
  status    StatusMensagem @default(ENVIADA)

  autorId  String
  autor    Usuario    @relation(fields: [autorId], references: [id])

  sessaoId String
  sessao   ChatSessao @relation(fields: [sessaoId], references: [id])

  respostaAId String?
  respostaA   Mensagem?  @relation("RespostaMensagem", fields: [respostaAId], references: [id])
  respostas   Mensagem[] @relation("RespostaMensagem")
}

model Avaliacao {
  id         String   @id @default(uuid())
  nota       Int      @db.SmallInt // 1 a 5 (CHECK chk_avaliacao_nota)
  comentario String?
  criadoEm   DateTime @default(now()) @db.Timestamptz(3)

  chamadoId String  @unique
  chamado   Chamado @relation(fields: [chamadoId], references: [id])

  autorId String
  autor   Usuario @relation(fields: [autorId], references: [id])
}
